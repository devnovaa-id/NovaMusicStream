# ===== NovaMusic Stream Environment Variables =====
# Copy this file to .env and fill in your values.

# --- Telegram API (https://my.telegram.org) ---
API_ID=123456
API_HASH=your_api_hash_here

# --- Bot Token (from @BotFather) ---
# Leave empty if using a User Session instead.
BOT_TOKEN=123456:ABC-DEF1234ghI-klmn0123456789

# --- User Session (Pyrogram string session) ---
# Required if BOT_TOKEN is empty. Generate with gen_telethon.py / NovaMusic:StringSession bot.
SESSION=

# --- Owner & Sudo ---
OWNER_ID=123456789
# Space-separated list of sudo user IDs.
SUDO_USERS=123456789 987654321

# --- Playback ---
# Max track duration (in seconds). Default: 300.
DURATION_LIMIT=300

# --- Images (optional, defaults shown) ---
PING_IMG=https://i.ibb.co.com/JRr0Nr2M/3bdff043-ba3f-40fe-86fd-48f5905d86c9.jpg
START_IMG=https://te.legra.ph/file/f8ba75bdbb9931cbc8229.jpg

# --- Support links (optional, defaults shown) ---
SUPPORT_CHAT=https://t.me/thiskeysa
SUPPORT_CHANNEL=https://t.me/dreamtorealitycreative
